{
  "name": "esa-pwd",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o css/tailwind.css --watch",
    "build:www": "npm run build:css && node scripts/build-www.js",
    "apk:add": "npm i @capacitor/core @capacitor/cli @capacitor/android && npx cap add android",
    "apk:sync": "npm run build:www && npx cap sync android",
    "apk:open": "npx cap open android"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@capacitor/inappbrowser": "^4.1.0"
  }
}
